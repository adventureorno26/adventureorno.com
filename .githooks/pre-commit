#!/usr/bin/env bash
# NO COMMIT ON A BROKEN TREE, AND NEVER ON main.
#
# Erica, 2026-08-11: "Make Claude work only on named branches. Allow commits only
# after tests pass; never commit automatically on session exit."
#
# The auto-commit-on-exit hooks are gone (~/.claude/settings.json, backed up as
# settings.json.bak-2026-08-11). This is the other half: even a deliberate commit
# has to earn it.
#
# Install (once per clone):   git config core.hooksPath .githooks
#
# Escape hatch for a genuine emergency, used out loud and never by an agent:
#   AON_SKIP_HOOK=1 git commit ...
set -euo pipefail

if [ "${AON_SKIP_HOOK:-}" = "1" ]; then
  echo "pre-commit: SKIPPED via AON_SKIP_HOOK=1" >&2
  exit 0
fi

branch="$(git rev-parse --abbrev-ref HEAD)"

# 1. NAMED BRANCHES ONLY. main is protected on GitHub too ("Changes must be made
#    through a pull request"), so committing here only creates work to undo.
if [ "$branch" = "main" ] || [ "$branch" = "HEAD" ]; then
  cat >&2 <<'MSG'

  ✋ Refusing to commit on main.

  Work happens on a named branch and reaches main through a pull request:

      git switch -c fix/what-this-is
      ...commit...
      gh pr create

  main is protected on GitHub as well, so a commit here cannot be pushed anyway.

MSG
  exit 1
fi

# 2. THE TESTS MUST PASS. Only when app code is actually part of the commit —
#    a docs-only or SQL-only change should not have to boot vitest.
staged="$(git diff --cached --name-only)"
if printf '%s\n' "$staged" | grep -qE '^app/(src|e2e)/.*\.(ts|tsx|css)$'; then
  echo "pre-commit: app code is staged — typechecking and running the unit tests…" >&2
  ( cd app && npx tsc -b ) || {
    echo >&2
    echo "  ✋ tsc failed. Fix it, then commit." >&2
    exit 1
  }
  ( cd app && npm run test --silent ) >/dev/null 2>&1 || {
    echo >&2
    echo "  ✋ The unit tests failed. Run 'npm run test --workspace app' to see it." >&2
    echo "     That includes lockedCard.test.ts — the words and structure Erica locked." >&2
    exit 1
  }
  echo "pre-commit: green." >&2
fi

# 3. THE PLAN CANNOT BE DELETED BY ACCIDENT.
#
#    On 2026-08-21 `docs/STATE.md` in the working tree was replaced by a copy 3,760 lines
#    older than HEAD, with the characters "ok" prepended to its first line — this repository
#    lives inside OneDrive, which has resurrected stale files before, and an editor holding an
#    old buffer does the same thing. Nothing was committed, and only because five separate
#    edits refused to find their anchors at once.
#
#    That was luck. This is not: a commit that removes most of the single planning document is
#    almost certainly a stale copy rather than an edit, and it has to be said out loud.
#
#    The threshold is deliberately loose. Real edits to this file add and remove tens of lines
#    routinely; the failure being caught deletes thousands.
if printf '%s\n' "$staged" | grep -qx 'docs/STATE.md'; then
  deleted="$(git diff --cached --numstat -- docs/STATE.md | awk '{print $2}')"
  total="$(git show HEAD:docs/STATE.md 2>/dev/null | wc -l | tr -d ' ')"
  #    A QUARTER, not a half. The 2026-08-20 move of §3b–3l into §7f deleted 524 lines of a
  #    5,400-line file — 10%, and entirely legitimate — while the stale copy deleted 73%.
  #    A quarter sits in the gap with room on both sides.
  if [ -n "$deleted" ] && [ -n "$total" ] && [ "$total" -gt 0 ] &&
     [ $(( deleted * 4 )) -gt "$total" ]; then
    echo >&2
    echo "  ✋ This commit deletes $deleted of $total lines of docs/STATE.md." >&2
    echo "     That is the shape of a STALE COPY, not an edit — check with:" >&2
    echo "         git diff --cached docs/STATE.md | head -40" >&2
    echo "     If the file on disk is older than HEAD:  git checkout -- docs/STATE.md" >&2
    echo "     If you really meant it:  AON_SKIP_HOOK=1 git commit ..." >&2
    exit 1
  fi

  #    3b. THE RATIO IS NOT ENOUGH, and 2026-08-31 proved it. A stale copy overwrote the file
  #    deleting 523 of 7,843 lines — 10%, which is exactly the figure the comment above cites
  #    as LEGITIMATE, so the quarter-threshold let it through. Tightening the ratio would only
  #    trade this miss for false alarms on the very section-move that comment is about.
  #
  #    So ask a different question. A stale copy LOSES section headings and adds none. A
  #    section MOVE deletes headings and re-adds the same ones, so the sorted comparison nets
  #    to zero. Measured on the 08-31 incident: 22 headings removed, 0 added. Measured on the
  #    08-20 move it is 0 and 0.
  head_old="$(git show HEAD:docs/STATE.md 2>/dev/null | grep -E '^#{2,6} ' | sort)"
  head_new="$(git show :docs/STATE.md 2>/dev/null | grep -E '^#{2,6} ' | sort)"
  gone="$(diff <(printf '%s\n' "$head_old") <(printf '%s\n' "$head_new") | grep -c '^<' || true)"
  added="$(diff <(printf '%s\n' "$head_old") <(printf '%s\n' "$head_new") | grep -c '^>' || true)"
  if [ "${gone:-0}" -ge 3 ] && [ "${added:-0}" -eq 0 ]; then
    echo >&2
    echo "  ✋ This commit removes $gone section headings from docs/STATE.md and adds none." >&2
    echo "     That is the shape of a STALE COPY. A section MOVE re-adds what it removes." >&2
    echo "     The headings that would disappear:" >&2
    diff <(printf '%s\n' "$head_old") <(printf '%s\n' "$head_new") | grep '^<' | sed 's/^< /         /' >&2
    echo "     If the file on disk is older than HEAD:  git checkout -- docs/STATE.md" >&2
    echo "     If you really meant it:  AON_SKIP_HOOK=1 git commit ..." >&2
    exit 1
  fi
fi

# 4. ONE DOCUMENT.
#
#    Erica, 2026-08-28: "fix EVERY fucking markdown file so you stop doing shit I dont want."
#
#    The thirteen competing plans were deleted from git on 2026-08-11 and were ALL still on
#    disk seventeen days later, because OneDrive restores what git removes. This runs on every
#    commit rather than only when markdown is staged: the failure mode is a file REAPPEARING
#    on its own, which never shows up in `git diff --cached`.
node scripts/check-one-document.mjs >/dev/null || {
  echo >&2
  echo "  ✋ A second planning document is present. Run:" >&2
  echo "         node scripts/check-one-document.mjs" >&2
  echo "     Plans go in docs/STATE.md. Nowhere else." >&2
  exit 1
}
