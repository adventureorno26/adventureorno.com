{
  "name": "adventureorno",
  "private": true,
  "version": "0.1.0",
  "description": "Private travel-map web app — adventureorno.com",
  "workspaces": [
    "app",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace app",
    "build": "npm run build --workspace app",
    "lint": "npm run lint --workspace app",
    "test": "npm run test --workspaces --if-present",
    "typecheck:workers": "npm run typecheck --workspace @adventureorno/photo-gateway",
    "gen:types": "node scripts/gen-types.mjs",
    "seed:e2e": "node scripts/seed-e2e-users.mjs",
    "preview": "npm run preview --workspace app",
    "check:edge-config": "node scripts/check-edge-config.mjs",
    "audit:production": "node scripts/check-production-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
