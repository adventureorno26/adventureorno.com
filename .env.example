# Copy to .env.local (gitignored). Never commit real values.

# --- Client-safe (bundled into the SPA, also set as Cloudflare Pages env vars) ---
# Supabase project URL
VITE_SUPABASE_URL=https://aanfyhsjbtnqzphuoiem.supabase.co
# Supabase publishable (anon) key — client-safe, RLS-protected
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# MapTiler key — client-safe but MUST be HTTP-origin-restricted in the MapTiler dashboard
VITE_MAPTILER_KEY=xxx
# Photo-gateway Worker base URL (Phase 2). e.g. https://adventureorno-photo-gateway.<subdomain>.workers.dev
# Leave blank until the Worker is deployed; photo upload/gallery hide themselves when unset.
VITE_PHOTO_GATEWAY_URL=
# Strava OAuth client id (public — safe to bundle). From strava.com/settings/api.
# Leave blank until the Strava app exists; the Connect-Strava button hides itself.
VITE_STRAVA_CLIENT_ID=

# --- Server-only secrets (NEVER committed / printed / bundled) ---
# Supabase service_role key. Used only by Edge Functions / local admin scripts.
# Paste from Supabase dashboard → Project Settings → API keys. Local use only.
SUPABASE_SERVICE_ROLE_KEY=
