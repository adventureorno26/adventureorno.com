# Copy to .env.local (gitignored). Never commit real values.
#
# Every VITE_* variable the app reads MUST appear here — scripts/check-env-example.mjs
# fails CI otherwise. VITE_* values are baked into the bundle at build time, so a
# missing one produces a broken build rather than a runtime error, and they are all
# client-visible by definition: never put a secret behind a VITE_ prefix.

# --- Client-safe (bundled into the SPA; also set as CI secrets for the gated build) ---

# Supabase project URL.
VITE_SUPABASE_URL=https://aanfyhsjbtnqzphuoiem.supabase.co

# Supabase publishable (anon) key — client-safe, RLS-protected. Starts sb_publishable_.
# NOT the legacy anon JWT: the legacy JWT keys were disabled project-wide on 2026-07-29.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# MapTiler key — client-safe but MUST be HTTP-origin-restricted (adventureorno.com +
# localhost) in the MapTiler dashboard, since it ships in the bundle.
# FAILOVER ONLY since 2026-08-10: Mapbox is the basemap (see VITE_MAPBOX_TOKEN).
# MapTiler suspended this account for exceeding quota and every map went blank.
VITE_MAPTILER_KEY=xxx

# Photo-gateway Worker base URL, e.g.
# https://adventureorno-photo-gateway.<subdomain>.workers.dev
# Leave blank until the Worker is deployed; photo upload/gallery hide themselves.
VITE_PHOTO_GATEWAY_URL=

# Strava OAuth client id (public — safe to bundle). From strava.com/settings/api.
# Leave blank until the Strava app exists; the Connect-Strava button hides itself.
VITE_STRAVA_CLIENT_ID=

# Google OAuth client id for the Google Photos picker (public — the browser picker
# flow needs no secret). Leave blank to hide the Google Photos import entry points.
VITE_GOOGLE_CLIENT_ID=

# Mapbox access token. THE BASEMAP (and business/POI search) since 2026-08-10 —
# with it absent the app falls back to MapTiler, which is currently suspended, so
# an empty value here means a blank map. Client-visible: restrict it by URL in the
# Mapbox dashboard AND set a spending limit, because through MapLibre Mapbox bills
# per TILE REQUEST, which is exactly how the MapTiler account was lost.
VITE_MAPBOX_TOKEN=

# --- Server-only secrets (NEVER committed, printed, or bundled) ---
# These are read by Edge Functions, the Worker, and local admin scripts. They are
# listed for completeness; each is supplied through Supabase/Wrangler secrets in the
# deployed environments and only lives here for local tooling.

# Supabase secret (service_role) key — bypasses RLS. Starts sb_secret_.
# Supersedes SUPABASE_SERVICE_ROLE_KEY, whose legacy JWT form was disabled
# project-wide on 2026-07-29.
SUPABASE_SECRET_KEY=

# Supabase Management API personal access token (sbp_...). Applies migrations and
# backs the db-types-drift / edge-config-drift CI jobs.
# NOTE: the Management API sits behind a Cloudflare WAF that returns 403 "error 1010"
# unless the request sends a browser-like User-Agent.
SUPABASE_ACCESS_TOKEN=

# Strava app credentials (server side of the OAuth exchange + webhook verification).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=

# Google OAuth client secret — server-side offline/refresh flow only. Never bundled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public site URL, used by Edge Functions to build absolute links (invites, OAuth
# redirects).
SITE_URL=https://adventureorno.com

# Cloudflare Pages deploy credentials (wrangler). The account id must be supplied
# explicitly because the Pages-scoped token cannot list accounts.
CLOUDFLARE_ACCOUNT_ID=9bed5239120cee4e9e7d46fa69ef4784
CLOUDFLARE_API_TOKEN=

# --- Local test/e2e only (defaults live in scripts/seed-e2e-users.mjs) ---
# Deterministic fictional identities seeded into a DISPOSABLE local Supabase stack.
# The seeding script refuses to run against a non-local host, and the mutating
# Playwright suite refuses to mint these tokens against a non-local host.
TEST_OWNER_EMAIL=owner.e2e@example.invalid
TEST_OWNER_PASSWORD=Local-E2E-owner-2026!
TEST_EDITOR_EMAIL=editor.e2e@example.invalid
TEST_EDITOR_PASSWORD=Local-E2E-editor-2026!
TEST_VIEWER_EMAIL=viewer.e2e@example.invalid
TEST_VIEWER_PASSWORD=Local-E2E-viewer-2026!
