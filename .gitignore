# dependencies
node_modules/
**/node_modules/

# build output
dist/
**/dist/
.vite/

# env & secrets — never commit
.env
.env.local
.env.*.local
# ...and ANY copy of them. The exact-match rules above do not cover backups or
# variants, and this directory has an auto-commit hook.
.env.local.*
.env*.bak*
*.bak-[0-9]*
.dev.vars

# supabase local
supabase/.branches
supabase/.temp

# editor / os
.DS_Store
*.log
.wrangler/

# test coverage
coverage/

# Playwright e2e artifacts
app/playwright-report/
app/test-results/
app/.playwright/
app/public/version.json

# Google Timeline Takeout dumps / partial downloads (never commit — huge)
app/TimlineTakeout/
TimlineTakeout/
*.crdownload

# Private household data — never commit. Raw DB snapshots (exact coordinates,
# dates, media keys, reviews) and the private planning spec live OUTSIDE the repo
# (preserved at ../AdventureOrNo-private-originals/). Fictional fixtures only.
supabase/snapshots/
NewClaude.md
*.jsonl

# TypeScript incremental build caches — generated by `tsc -b`, reproducible.
*.tsbuildinfo

# Disposable DB bootstrap error log
.db-bootstrap.errors.log

# Backup working directory — plaintext dumps live here briefly; never commit.
.backup-work/

# Claude Code local session settings — machine-specific, not shared.
.claude/settings.local.json

# Agent worktrees — full checkouts of this repo, created and removed per session.
.claude/worktrees/
