# dependencies
node_modules/
**/node_modules/

# build output
dist/
**/dist/
.vite/

# env & secrets — never commit
.env
.env.local
.env.*.local
# ...and ANY copy of them. A `cp .env.local .env.local.bak-<ts>` backup was committed
# by the auto-save hook on 2026-08-10 and leaked 17 secrets: the exact-match rules
# above did not cover it.
.env.local.*
.env*.bak*
*.bak-[0-9]*
.dev.vars

# supabase local
supabase/.branches
supabase/.temp

# editor / os
.DS_Store
*.log
.wrangler/

# test coverage
coverage/

# Playwright e2e artifacts
app/playwright-report/
app/test-results/
app/.playwright/
app/public/version.json

# Google Timeline Takeout dumps / partial downloads (never commit — huge)
app/TimlineTakeout/
TimlineTakeout/
*.crdownload

# Private household data — never commit. Raw DB snapshots (exact coordinates,
# dates, media keys, reviews) and the private planning spec live OUTSIDE the repo
# (preserved at ../AdventureOrNo-private-originals/). Fictional fixtures only.
supabase/snapshots/
NewClaude.md
*.jsonl

# TypeScript incremental build caches — generated by `tsc -b`, reproducible.
*.tsbuildinfo

# Disposable DB bootstrap error log
.db-bootstrap.errors.log
